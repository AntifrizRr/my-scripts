# Required parameters
AFFILKA_BASE_URL=
AFFILKA_OPERATOR_EMAIL=
AFFILKA_OPERATOR_PASSWORD=
AFFILKA_TOTP_SECRET=
DIRECTORY_SHEET_ID=
DIRECTORY_TAB_NAME=
PLAN_FACT_SHEET_ID=
PLAN_FACT_TAB_NAME=

# Optional parameters
AFFILKA_RPM=60
PLAN_FACT_COL_AFF_ID=Affiliate ID
PLAN_FACT_COL_AFF_NAME=Affiliate
GOOGLE_AUTH_MODE=oauth
GOOGLE_OAUTH_CLIENT_FILE=credentials.json
GOOGLE_OAUTH_TOKEN_FILE=token.json
